# Razent backend — Supabase (optional)
# When both are set, lib/api/client.ts uses Supabase.
# When missing, the in-memory store (lib/storage/*) is used as fallback.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay (test or live keys; populate later)
VITE_RAZORPAY_KEY_ID=
VITE_RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_WEBHOOK_SECRET=

# Supabase Edge Functions (optional — auto-detected from VITE_SUPABASE_URL when deployed)
VITE_UAP_VERIFIER_URL=
VITE_X402_CHALLENGE_URL=
VITE_EXECUTE_AGENT_CHECKOUT_URL=

# NPCI UAP testing key (shared secret for agent-to-agent test signatures)
UAP_TEST_SIGNING_KEY=
