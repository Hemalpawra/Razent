# Razent backend — Supabase (optional)
# When both are set, lib/api/client.ts uses Supabase.
# When missing, the in-memory store (lib/storage/*) is used as fallback.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay (test or live keys; populate later)
VITE_RAZORPAY_KEY_ID=
VITE_RAZORPAY_KEY_SECRET=
