# Razent backend — Supabase (REQUIRED)
# Without these two vars the app shows an EnvErrorBoundary card
# instead of a blank screen. Set both before running `pnpm dev`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenRouter (REQUIRED for ragent-chat Edge Function — PR 4)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Razorpay (test mode is fine; degraded demo works without these)
VITE_RAZORPAY_KEY_ID=
VITE_RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_WEBHOOK_SECRET=

# Supabase Edge Function URLs (auto-resolved from VITE_SUPABASE_URL when deployed)
VITE_UAP_VERIFIER_URL=
VITE_X402_CHALLENGE_URL=
VITE_EXECUTE_AGENT_CHECKOUT_URL=

# NPCI UAP testing key (shared secret for agent-to-agent test signatures)
UAP_TEST_SIGNING_KEY=
