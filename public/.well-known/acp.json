{
  "acp_version": "2026-01-16",
  "name": "Razent Quick Commerce ACP Gateway",
  "merchant": {
    "id": "merchant_one_razent",
    "business_name": "Merchant One",
    "country": "IN",
    "currency": "INR"
  },
  "endpoints": {
    "create_session": "/api/a2a/acp/checkout_sessions",
    "get_session": "/api/a2a/acp/checkout_sessions/{id}",
    "update_session": "/api/a2a/acp/checkout_sessions/{id}",
    "complete_session": "/api/a2a/acp/checkout_sessions/{id}/complete",
    "cancel_session": "/api/a2a/acp/checkout_sessions/{id}/cancel"
  },
  "supported_versions": ["2026-01-16", "2026-04-17"],
  "capabilities": {
    "supported_interventions": ["3ds", "biometric", "custom_redirect"],
    "supported_handlers": [
      "dev.acp.upi_autopay",
      "dev.acp.tokenized.card",
      "dev.acp.seller_backed.saved_card",
      "dev.acp.seller_backed.store_credit"
    ]
  },
  "settlement": {
    "gateway": "razorpay",
    "api_version": "v1",
    "webhook_header": "X-ACP-Signature",
    "signature_algorithm": "HMAC-SHA256",
    "replay_tolerance_seconds": 300
  },
  "idempotency": {
    "header": "Idempotency-Key",
    "lifetime_seconds": 86400,
    "conflict_response_code": 409
  }
}
