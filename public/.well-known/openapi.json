{
  "openapi": "3.1.0",
  "info": {
    "title": "Razent Pre-Production Agentic Commerce API (UCP / ACP / AP2)",
    "version": "2026.1.0",
    "description": "Authoritative machine-to-machine commerce gateway unifying Universal Commerce Protocol (UCP), Agentic Commerce Protocol (ACP), and Google Agent Payments Protocol (AP2) backed by Razorpay Test Rails."
  },
  "servers": [
    {
      "url": "https://flsjhsnfurxkzawdimyi.supabase.co/functions/v1/a2a",
      "description": "Live Supabase A2A Gateway"
    }
  ],
  "paths": {
    "/catalog": {
      "get": {
        "operationId": "searchUCPCatalog",
        "summary": "Search UCP Catalog",
        "description": "Federated catalog discovery and product search supporting natural language, category filtering, and price caps.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Search keyword or phrase e.g. milk, apple, oil",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Product category e.g. Dairy & Eggs, Pantry, Fresh Produce",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_price_paise",
            "in": "query",
            "description": "Maximum price limit in paise (e.g. 50000 = 500 INR)",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "in_stock_only",
            "in": "query",
            "description": "Filter only available items in stock",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Catalog matching products",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UCPCatalogResponse"
                }
              }
            }
          }
        }
      }
    },
    "/checkout_sessions": {
      "post": {
        "operationId": "createACPCheckoutSession",
        "summary": "Create ACP Checkout Session",
        "description": "Initiates an ACP checkout session, negotiating capabilities and generating an authoritative order reference.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ACPCheckoutSessionCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Checkout session created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ACPCheckoutSession"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/checkout_sessions/{id}": {
      "get": {
        "operationId": "getACPCheckoutSession",
        "summary": "Get ACP Checkout Session",
        "description": "Retrieves current status, items, totals, and payment readiness of a checkout session.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique ACP checkout session ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ACPCheckoutSession"
                }
              }
            }
          },
          "404": {
            "description": "Session not found"
          }
        }
      }
    },
    "/checkout_sessions/{id}/complete": {
      "post": {
        "operationId": "completeACPCheckoutSession",
        "summary": "Complete ACP Checkout Session",
        "description": "Completes checkout session, creates authoritative Razorpay order, and binds mandate chain.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique ACP checkout session ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ACPCheckoutSessionCompleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkout completed and order settled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ACPCheckoutSessionCompleteResponse"
                }
              }
            }
          },
          "400": {
            "description": "Settlement failed or invalid mandate"
          }
        }
      }
    },
    "/mandate": {
      "post": {
        "operationId": "createAP2CartMandate",
        "summary": "Create AP2 Cart Mandate",
        "description": "Generates RFC 8785 canonical SHA-256 hash and WebCrypto ES256 digital signature of requested items.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AP2CartMandateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized Cart Mandate with merchant signature",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AP2CartMandateResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UCPCatalogResponse": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "string"
          },
          "matches_count": {
            "type": "integer"
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "price_paise": {
                  "type": "integer"
                },
                "price_rupees": {
                  "type": "string"
                },
                "currency": {
                  "type": "string"
                },
                "stock": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "ACPCheckoutSessionCreateRequest": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "quantity"],
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "Product ID"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "delivery_address": {
            "type": "object",
            "properties": {
              "full_name": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "line1": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "pincode": {
                "type": "string"
              }
            }
          }
        }
      },
      "ACPCheckoutSession": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "payment_url": {
            "type": "string",
            "description": "Direct Razorpay secure payment link (UPI, GPay, Cards). CRITICAL: Always display this link to the customer as an embedded markdown button or text link: [Click here to Pay on Razorpay](payment_url). Never show the raw URL."
          },
          "payment_link": {
            "type": "string",
            "description": "Secure payment link. CRITICAL: Display as embedded markdown link: [Click here to Pay on Razorpay](payment_link)."
          },
          "payment_instruction": {
            "type": "string",
            "description": "Instruction for the customer to review and pay via embedded markdown link."
          },
          "totals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "amount": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "ACPCheckoutSessionCompleteRequest": {
        "type": "object",
        "properties": {
          "payment_handler": {
            "type": "string",
            "example": "dev.acp.upi_autopay"
          },
          "mandate_id": {
            "type": "string"
          },
          "upi_vpa": {
            "type": "string",
            "example": "customer@okhdfcbank"
          }
        }
      },
      "AP2CartMandateRequest": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "quantity"],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "quantity": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "ACPCheckoutSessionCompleteResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "order_id": {
            "type": "string"
          },
          "razorpay_order_id": {
            "type": "string"
          },
          "amount_paid_rupees": {
            "type": "string"
          },
          "settlement_rail": {
            "type": "string"
          },
          "delivery_eta": {
            "type": "string"
          },
          "invoice_url": {
            "type": "string",
            "description": "Official printable GST Tax Invoice direct download URL. CRITICAL FOR ASSISTANT: Always present this to the user as an embedded markdown button: [Click here to Download Tax Invoice](invoice_url). Never show the raw link."
          },
          "tracking_url": {
            "type": "string",
            "description": "Live delivery tracking link. CRITICAL FOR ASSISTANT: Always present this to the user as an embedded markdown button: [Click here to Track Live Delivery](tracking_url). Never show the raw link."
          },
          "instructions": {
            "type": "string",
            "description": "Formatting instructions for the assistant"
          }
        }
      },
      "AP2CartMandateResponse": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "mandate_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "algorithm": {
            "type": "string"
          },
          "hash_algorithm": {
            "type": "string"
          }
        }
      }
    }
  }
}
