{
  "ap2_version": "1.0.0",
  "specification_url": "https://github.com/google-agentic-commerce/AP2",
  "merchant": {
    "id": "merchant_one_razent",
    "name": "Merchant One",
    "currency": "INR",
    "country": "IN"
  },
  "roles_supported": ["merchant", "settlement_bridge"],
  "mandate_chain": {
    "intent_mandate": {
      "required_fields": ["id", "price_cap_paise", "currency", "agent_id"],
      "optional_fields": ["skus", "intent_expiry", "user_signature"]
    },
    "cart_mandate": {
      "canonicalization": "RFC-8785",
      "hash_algorithm": "SHA-256",
      "signature_algorithm": "ES256",
      "jwks_uri": "/.well-known/jwks.json",
      "validity_seconds": 900
    },
    "payment_mandate": {
      "supported_rails": ["upi_autopay", "cards"],
      "cryptographic_binding": "SHA-256-JCS",
      "threshold_regulation": {
        "regulatory_body": "NPCI/RBI",
        "max_recurring_limit_paise": 1500000,
        "step_up_protocol": "x402"
      }
    }
  },
  "verification_endpoint": "/api/a2a/ap2/mandate/verify"
}
