{
  "ucp_version": "2026-01-16",
  "business_name": "Merchant One (Razent Quick Commerce)",
  "merchant_id": "merchant_one_razent",
  "description": "Universal Commerce Protocol manifest for 10-15 min grocery delivery. Supports federated catalog query, synchronized carts, and cryptographic checkout bridge.",
  "currency": "INR",
  "country": "IN",
  "transports": ["rest", "a2a", "mcp"],
  "services": {
    "dev.ucp.shopping.catalog": {
      "transport": "rest",
      "endpoint": "/api/a2a/ucp/catalog",
      "version": "1.0.0",
      "methods": ["GET", "POST"],
      "description": "Federated product catalog discovery and full-text search"
    },
    "dev.ucp.shopping.cart": {
      "transport": "rest",
      "endpoint": "/api/a2a/ucp/cart",
      "version": "1.0.0",
      "methods": ["POST"],
      "description": "Ephemeral cart negotiation with integer paise arithmetic and tax calculation"
    },
    "dev.ucp.shopping.orders": {
      "transport": "rest",
      "endpoint": "/api/a2a/ucp/orders",
      "version": "1.0.0",
      "methods": ["GET"],
      "description": "Order lifecycle state tracking, delivery rider assignment, and fulfillment status"
    },
    "dev.ucp.shopping.checkout": {
      "transport": "rest",
      "endpoint": "/api/a2a/acp/checkout_sessions",
      "version": "2026-01-16",
      "protocol": "acp",
      "methods": ["POST", "GET"],
      "description": "Direct bridge to Agentic Commerce Protocol checkout sessions"
    }
  },
  "payment_handlers": [
    {
      "id": "dev.acp.upi_autopay",
      "name": "UPI AutoPay / e-Mandate",
      "spec": "NPCI UPI 2.0 / AutoPay Circular 2023",
      "supported_currencies": ["INR"],
      "max_limit_rupees": 15000
    },
    {
      "id": "dev.acp.tokenized.card",
      "name": "RBI Tokenized Credit/Debit Cards",
      "spec": "RBI CoFT / Network Tokenization",
      "supported_currencies": ["INR", "USD"]
    },
    {
      "id": "dev.acp.seller_backed.saved_card",
      "name": "Razorpay Vault Stored Payment",
      "spec": "Razorpay Customer Tokenization API",
      "supported_currencies": ["INR"]
    },
    {
      "id": "dev.acp.seller_backed.store_credit",
      "name": "Merchant Wallet Credit",
      "spec": "Internal Razent Wallet",
      "supported_currencies": ["INR"]
    }
  ],
  "mcp_server": {
    "name": "razent-commerce-mcp",
    "endpoint": "https://flsjhsnfurxkzawdimyi.supabase.co/functions/v1/ragent-chat",
    "protocol_version": "2024-11-05"
  },
  "cryptography": {
    "jwks_uri": "/.well-known/jwks.json",
    "hash_algorithm": "SHA-256",
    "canonicalization": "RFC-8785",
    "signature_algorithm": "ES256"
  }
}
